// College Event Booking System - Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for college students
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  college   String?  // College name for validation
  studentId String?  // Student ID number
  phone     String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  eventRegistrations EventRegistration[]

  @@map("users")
}

// Events model for college activities
model Event {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  eventType        EventType
  date             DateTime
  startTime        DateTime @map("start_time")
  endTime          DateTime @map("end_time")
  location         String
  maxSeats         Int      @default(100) @map("max_seats")
  availableSeats   Int      @default(100) @map("available_seats")
  registrationFee  Float?   @default(0) @map("registration_fee")
  isActive         Boolean  @default(true) @map("is_active")
  organizerName    String   @map("organizer_name")
  organizerContact String   @map("organizer_contact")
  imageUrl         String?  @map("image_url")
  requirements     String?  // Special requirements or prerequisites
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  eventRegistrations EventRegistration[]
  timeSlots          TimeSlot[]

  @@map("events")
}

// Time slots for events
model TimeSlot {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  maxCapacity Int      @default(50) @map("max_capacity")
  currentCount Int     @default(0) @map("current_count")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventRegistrations EventRegistration[]

  @@map("time_slots")
}

// Event registrations/bookings
model EventRegistration {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id") // Optional for guest registrations
  eventId     Int      @map("event_id")
  timeSlotId  Int?     @map("time_slot_id")
  fullName    String   @map("full_name")
  email       String
  phone       String
  college     String
  seats       Int      @default(1)
  comments    String?
  status      RegistrationStatus @default(CONFIRMED)
  ticketCode  String   @unique @map("ticket_code") // QR code identifier
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)

  @@map("event_registrations")
}

// Enums
enum Role {
  STUDENT
  ADMIN
  ORGANIZER
}

enum EventType {
  WORKSHOP
  SEMINAR
  CULTURAL
  SPORTS
  TECHNICAL
  MEETUP
  CONFERENCE
  OTHER
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}
